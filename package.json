{
  "name": "git-agent-local",
  "version": "0.1.0",
  "description": "Zero-API, 100% offline, AST-aware AI terminal agent for Git workflows powered by local LLMs (Ollama / LM Studio).",
  "keywords": [
    "git",
    "ai",
    "ollama",
    "llm",
    "local-first",
    "offline",
    "commit-message",
    "ast",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "author": "git-agent-local contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/silentnova99/git-agent-local.git"
  },
  "homepage": "https://github.com/silentnova99/git-agent-local#readme",
  "bugs": {
    "url": "https://github.com/silentnova99/git-agent-local/issues"
  },
  "bin": {
    "git-agent": "./bin/git-agent.js"
  },
  "main": "./dist/cli/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node bin/git-agent.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.25.9",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
